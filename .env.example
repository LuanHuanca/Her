# Copiar este archivo a .env y ajustar los valores para desarrollo local.
# NUNCA commitear el archivo .env — ya está en .gitignore.

# ── Base de datos ──────────────────────────────────────────────
POSTGRES_USER=her
POSTGRES_PASSWORD=herpassword
POSTGRES_DB=her_db

# ── Backend / JWT ──────────────────────────────────────────────
# Cambiar por una cadena aleatoria larga en producción
SECRET_KEY=supersecretkey-change-in-production
